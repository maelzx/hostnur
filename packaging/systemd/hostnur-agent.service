[Unit]
Description=Hostnur privileged operations agent
Documentation=https://github.com/maelzx/hostnur
After=network.target
ConditionPathExists=/etc/hostnur/agent.toml

[Service]
Type=simple
# The agent performs privileged provisioning and deployment (Linux account/
# layout creation, Nginx/FPM/systemd configuration, package installation), so it
# runs as root. It still resolves every action from agent-owned, UUID-derived
# resources; caller-supplied paths/commands are never trusted. Fine-grained
# hardening (capability split or a separate privileged helper) is deferred until
# the privileged handler surface is finalized; the earlier read-only floor
# directives (empty CapabilityBoundingSet, ProtectSystem=strict) are NOT used
# here because they block the required UID switching and config writes.
User=root
Group=root
RuntimeDirectory=hostnur
RuntimeDirectoryMode=0750
StateDirectory=hostnur/agent
StateDirectoryMode=0700
ExecStart=/usr/local/bin/hostnur-agent run --config /etc/hostnur/agent.toml
Restart=on-failure
RestartSec=2
# Safe for privileged work: no new privileges via setuid binaries, private /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
