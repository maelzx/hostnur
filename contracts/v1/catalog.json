{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "protocol_versions": [1],
    "operations": {
        "agent.capabilities": {
            "resource": null,
            "parameters": {},
            "read_only": true,
            "retry": "bounded"
        },
        "agent.inspect": {
            "resource": null,
            "parameters": {
                "execution_id": { "type": "uuid", "required": true }
            },
            "read_only": true,
            "retry": "bounded"
        },
        "agent.cancel": {
            "resource": null,
            "parameters": {
                "execution_id": { "type": "uuid", "required": true }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "agent.register_application": {
            "resource": null,
            "parameters": {
                "application": { "type": "uuid", "required": true },
                "repository_url": { "type": "string", "required": true, "max": 2048 },
                "server_name": { "type": "string", "required": true, "max": 253 },
                "provider": { "type": "string", "required": true, "max": 64 },
                "runtime": { "type": "string", "required": true, "max": 32 },
                "runtime_version": { "type": "string", "required": true, "max": 32 }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "agent.register_schedule": {
            "resource": null,
            "parameters": {
                "schedule": { "type": "uuid", "required": true },
                "application": { "type": "uuid", "required": true },
                "program": { "type": "string", "required": true, "max": 255 },
                "arguments": { "type": "string", "required": false, "max": 4096 },
                "expression": { "type": "string", "required": true, "max": 255 },
                "timezone": { "type": "string", "required": true, "max": 64 }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "agent.remove_schedule": {
            "resource": null,
            "parameters": {
                "schedule": { "type": "uuid", "required": true }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "agent.register_certificate": {
            "resource": null,
            "parameters": {
                "certificate": { "type": "string", "required": true, "max": 64 },
                "hostname": { "type": "string", "required": true, "max": 253 },
                "application": { "type": "uuid", "required": false },
                "certificate_pem": { "type": "string", "required": false, "max": 65536 },
                "private_key": { "type": "string", "required": false, "max": 65536 }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "agent.register_database": {
            "resource": null,
            "parameters": {
                "database": { "type": "uuid", "required": true },
                "application": { "type": "uuid", "required": true }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "agent.remove_database": {
            "resource": null,
            "parameters": {
                "database": { "type": "uuid", "required": true }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "database.rotate": {
            "resource": null,
            "parameters": {
                "database": { "type": "uuid", "required": true }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "database.export": {
            "resource": null,
            "parameters": {
                "database": { "type": "uuid", "required": true }
            },
            "read_only": true,
            "retry": "bounded"
        },
        "database.import": {
            "resource": null,
            "parameters": {
                "database": { "type": "uuid", "required": true },
                "dump": { "type": "string", "required": true, "max": 262144 }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "server.snapshot": {
            "resource": null,
            "parameters": {},
            "read_only": true,
            "retry": "bounded"
        },
        "server.updates": {
            "resource": null,
            "parameters": {},
            "read_only": true,
            "retry": "bounded"
        },
        "application.deploy": {
            "resource": "application",
            "parameters": {
                "revision": { "type": "uuid", "required": true },
                "ref": { "type": "string", "required": false, "max": 255 },
                "run_migrations": { "type": "boolean", "required": false },
                "recovery_acknowledged": { "type": "boolean", "required": false }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "application.restart": {
            "resource": "application",
            "parameters": {},
            "read_only": false,
            "retry": "capability_declared"
        },
        "application.rollback": {
            "resource": "application",
            "parameters": {
                "release": { "type": "uuid", "required": true }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "service.control": {
            "resource": "service",
            "parameters": {
                "action": { "type": "enum", "required": true, "values": ["start", "stop", "restart"] }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "package.install": {
            "resource": null,
            "parameters": {
                "package": { "type": "string", "required": true, "max": 255 }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "package.upgrade": {
            "resource": null,
            "parameters": {
                "security": { "type": "boolean", "required": false }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "agent.register_package": {
            "resource": null,
            "parameters": {
                "package": { "type": "string", "required": true, "max": 64 }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "agent.remove_package": {
            "resource": null,
            "parameters": {
                "package": { "type": "string", "required": true, "max": 64 }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "schedule.apply": {
            "resource": "schedule",
            "parameters": {
                "revision": { "type": "integer", "required": true }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "certificate.issue": {
            "resource": "domain",
            "parameters": {
                "provider": { "type": "enum", "required": true, "values": ["http01"] }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "certificate.install": {
            "resource": "domain",
            "parameters": {
                "certificate": { "type": "string", "required": true, "max": 255 }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "database.provision": {
            "resource": null,
            "parameters": {
                "request": { "type": "uuid", "required": true }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "agent.register_backup": {
            "resource": null,
            "parameters": {
                "backup": { "type": "uuid", "required": true },
                "scope": { "type": "enum", "required": true, "values": ["application_data", "control_state", "server"] },
                "application": { "type": "uuid", "required": false }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "backup.create": {
            "resource": "backup",
            "parameters": {
                "policy": { "type": "uuid", "required": false }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "backup.restore": {
            "resource": "backup",
            "parameters": {
                "identity": { "type": "string", "required": true, "max": 1024 },
                "artifact": { "type": "string", "required": false, "max": 255 }
            },
            "read_only": false,
            "retry": "no_blind_replay"
        },
        "firewall.rule.add": {
            "resource": null,
            "parameters": {
                "port": { "type": "integer", "required": true },
                "protocol": { "type": "enum", "required": true, "values": ["tcp", "udp"] },
                "source": { "type": "string", "required": false, "max": 64 },
                "action": { "type": "enum", "required": true, "values": ["allow", "deny"] }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "firewall.rule.remove": {
            "resource": null,
            "parameters": {
                "port": { "type": "integer", "required": true },
                "protocol": { "type": "enum", "required": true, "values": ["tcp", "udp"] },
                "source": { "type": "string", "required": false, "max": 64 },
                "action": { "type": "enum", "required": true, "values": ["allow", "deny"] }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "firewall.web": {
            "resource": null,
            "parameters": {
                "https_only": { "type": "boolean", "required": true }
            },
            "read_only": false,
            "retry": "capability_declared"
        },
        "application.logs": {
            "resource": "application",
            "parameters": {},
            "read_only": true,
            "retry": "bounded"
        },
        "application.metrics": {
            "resource": "application",
            "parameters": {},
            "read_only": true,
            "retry": "bounded"
        },
        "application.observe": {
            "resource": "application",
            "parameters": {},
            "read_only": true,
            "retry": "bounded"
        },
        "application.start": {
            "resource": "application",
            "parameters": {},
            "read_only": false,
            "retry": "capability_declared"
        },
        "application.stop": {
            "resource": "application",
            "parameters": {},
            "read_only": false,
            "retry": "capability_declared"
        }
    }
}
