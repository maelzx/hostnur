{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hostnur.dev/contracts/v1/server-snapshot.schema.json",
    "title": "ServerSnapshot",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "protocol_version",
        "mode",
        "available",
        "sampled_at",
        "metrics",
        "services"
    ],
    "properties": {
        "protocol_version": { "const": 1 },
        "mode": { "enum": ["unavailable", "fake", "real"] },
        "available": { "type": "boolean" },
        "sampled_at": { "type": "string", "minLength": 1 },
        "metrics": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "value": { "type": "number" },
                    "unit": { "type": ["string", "null"] }
                }
            }
        },
        "services": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "status"],
                "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "status": { "type": "string", "minLength": 1 }
                }
            }
        },
        "reason": { "type": ["string", "null"] },
        "hostname": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "firewall": {
            "oneOf": [
                { "type": "null" },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["enabled", "incoming_policy", "rule_count"],
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "incoming_policy": { "type": "string", "minLength": 1 },
                        "rule_count": { "type": "integer", "minimum": 0 },
                        "rules": {
                            "type": "array",
                            "maxItems": 100,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["port", "protocol", "source", "action"],
                                "properties": {
                                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                                    "protocol": { "enum": ["tcp", "udp"] },
                                    "source": { "type": "string", "minLength": 1 },
                                    "action": { "enum": ["allow", "deny"] }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
