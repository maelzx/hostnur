{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hostnur.dev/contracts/v1/application-observation.schema.json",
    "title": "ApplicationObservation",
    "type": "object",
    "additionalProperties": false,
    "required": ["protocol_version", "application_id", "lifecycle", "active_release", "mode", "sampled_at"],
    "properties": {
        "protocol_version": { "const": 1 },
        "application_id": { "type": "string", "minLength": 1 },
        "lifecycle": {
            "enum": ["reserved", "account_created", "layout_prepared", "ready", "failed", "drifted", "unknown"]
        },
        "active_release": { "type": ["string", "null"] },
        "mode": { "enum": ["unavailable", "fake", "real"] },
        "sampled_at": { "type": "string", "minLength": 1 }
    }
}
